* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  height: 100vh;
  display: flex;
  justify-content: center;
  align-items: center;
  background: radial-gradient(circle at top, #f9f9f9, #dcdcdc);
  perspective: 1200px;
  overflow: hidden;
}

/* Room container */
.room {
  position: relative;
  width: 80vw;
  max-width: 700px;
  aspect-ratio: 3 / 2;
  transform-style: preserve-3d;
  transform: rotateX(10deg) rotateY(0deg);
}

/* Common wall style */
.wall {
  position: absolute;
  width: 100%;
  height: 80%;
  top: 0;
  backface-visibility: hidden;
  box-shadow: inset -10px -15px 25px rgba(0, 0, 0, 0.25);
}

/* Front wall with geometric design */
.wall.front {
  background: linear-gradient(
      135deg,
      #305d6e 0%,
      #305d6e 35%,
      #c8b7a6 35%,
      #c8b7a6 55%,
      #e6e4e1 55%,
      #a9b9b3 100%
    );
  transform: translateZ(-150px);
  display: flex;
  justify-content: center;
  align-items: center;
}

/* Window */
.window {
  width: 22%;
  aspect-ratio: 3 / 4;
  background: linear-gradient(to bottom, #ffffff, #f5f5f5);
  border: 0.6vw solid #f0f0f0;
  box-shadow: 0 0 2vw rgba(0, 0, 0, 0.35),
              inset 0 0 15px rgba(255, 255, 255, 0.7);
  z-index: 2;
}

/* Left wall */
.wall.left {
  width: 300px;
  height: 80%;
  background: #efefef;
  transform: rotateY(90deg) translateZ(50%);
  transform-origin: left;
  box-shadow: inset 20px 0 30px rgba(0, 0, 0, 0.2);
}

/* Right wall */
.wall.right {
  width: 300px;
  height: 80%;
  background: #f2f2f2;
  transform: rotateY(-90deg) translateZ(50%);
  transform-origin: right;
  box-shadow: inset -20px 0 30px rgba(0, 0, 0, 0.2);
}

/* Ceiling */
.ceiling {
  position: absolute;
  width: 100%;
  height: 20%;
  background: linear-gradient(to bottom, #e9e9e9, #d9d9d9);
  transform: rotateX(90deg) translateZ(150px);
  transform-origin: top;
  box-shadow: inset 0 -10px 20px rgba(0, 0, 0, 0.2);
}

/* Floor with depth and texture */
.floor {
  position: absolute;
  bottom: 0;
  width: 100%;
  height: 25%;
  background: repeating-linear-gradient(
    90deg,
    #d2b48c,
    #d2b48c 10px,
    #c8a97e 10px,
    #c8a97e 20px
  );
  transform: rotateX(-90deg) translateZ(100px);
  transform-origin: bottom;
  box-shadow: inset 0 15px 30px rgba(0, 0, 0, 0.3);
}

/* Ambient light glow */
.room::before {
  content: "";
  position: absolute;
  inset: 0;
  background: radial-gradient(circle at 50% 20%, rgba(255,255,255,0.6), transparent 70%);
  pointer-events: none;
}

/* Responsive adjustments */
@media (max-width: 600px) {
  .window {
    width: 28%;
    border-width: 1vw;
  }
}

@media (max-width: 400px) {
  .window {
    width: 32%;
  }
}


<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>3D Geometric Corner Room</title>
  <link rel="stylesheet" href="style.css" />
</head>
<body>
  <div class="room">
    <div class="wall front">
      <div class="window"></div>
    </div>
    <div class="wall left"></div>
    <div class="wall right"></div>
    <div class="ceiling"></div>
    <div class="floor"></div>
  </div>
</body>
</html>
